{
  "name": "builderos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @builderos/api\" \"npm run dev -w @builderos/web\"",
    "dev:api": "npm run dev -w @builderos/api",
    "dev:web": "npm run dev -w @builderos/web",
    "build": "npm run build -w @builderos/web && npm run build -w @builderos/api",
    "start": "npm run start -w @builderos/api",
    "db:migrate": "npm run db:migrate -w @builderos/api",
    "db:seed": "npm run db:seed -w @builderos/api",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
