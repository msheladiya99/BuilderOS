# BuilderOS Backend — copy to .env in this folder

NODE_ENV=development
API_PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://builderos:builderos_dev@localhost:5432/builderos

# Redis (Phase 2+)
REDIS_URL=redis://localhost:6379

# Auth (min 16 characters for JWT_SECRET)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
OTP_DEMO_CODE=123456

# CORS — frontend URL(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# App
MAIN_DOMAIN=localhost
SUPERADMIN_EMAIL=superadmin@builderos.in

# S3 (Phase 2+)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=builderos-documents
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
